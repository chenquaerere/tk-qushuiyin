# ============================================================
#  TK去水印高清程序 · Git 忽略清单
# ------------------------------------------------------------
#  本仓库只提交「源码」。模型权重、内置运行时、虚拟环境、
#  用户素材、运行日志一律不入库（原因见 README「首次运行」）。
# ============================================================

# ---------- 模型权重（合计约 1.35 GB，需自行下载）----------
models/
gfpgan/weights/

# ---------- 自带运行时与大体积依赖（合计约 5.4 GB）----------
venv/
python-runtime/
tools/
gfpgan/*.egg-info/

# ---------- 运行期数据 ----------
runtime/
logs/
output/
uploads/

# ---------- 用户配置与日志（含本机路径 / 局域网设置）----------
config.json
launcher.log
app.log
*.log
python_path.txt

# ---------- 备份 / 归档 ----------
_backup_*/
*.zip

# ---------- 已编译的启动器（可选：二进制不入库）----------
# 如需随仓库分发 exe，删掉下面两行再提交即可
*.exe
*.exe.bak

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ---------- 虚拟环境 / 工具缓存 ----------
env/
ENV/
.venv/
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
